<?xml version='1.0' encoding='UTF-8'?>
<jube>
  <benchmark name='figure_creation' outpath='bench_run'>
    <comment>A figure creation example</comment>

    <parameterset name='param_set'>
      <parameter name='i'>0,1,2,3</parameter>
      <parameter name='x2' mode='python'>[0,2,4,6][$i]</parameter>
      <parameter name='y2' mode='python'>[10,11,8,9][$i]</parameter>
    </parameterset>

    <parameterset name='groupby_params'>
      <parameter name='type'>Typ1,Typ2,Typ3</parameter>
      <parameter name='x'>0,1,2,3</parameter>
      <parameter name='y' mode='python'>
        {
          'Typ1' : [11,12,11,13][$x],
          'Typ2' : [19,18,19,22][$x],
          'Typ3' : [40,20,35,25][$x],
        }.get('${type}',0)
      </parameter>
    </parameterset>
    
    <!-- Regex pattern -->
    <patternset name='pattern_all'>
      <pattern name='type_pat'>type: ${jube_pat_wrd}${jube_pat_bl}</pattern>
      <pattern name='x_pat' type='int'>x: $jube_pat_int</pattern>
      <pattern name='x2_pat' type='int'>x2: $jube_pat_int</pattern>
      <pattern name='y_pat'  type='int'>y: $jube_pat_int</pattern>
      <pattern name='y2_pat'  type='int'>y2: $jube_pat_int</pattern>
    </patternset>
    
    <!-- Operation -->
    <step name='write_numbers'>
      <use>param_set</use> <!-- use existing parameterset -->
      <do>echo 'x2: $x2; y2: $y2'</do> <!-- shell command -->
    </step>

    <step name='write_groupby'>
      <use>groupby_params</use> <!-- use existing parameterset -->
      <do>echo 'type: ${type} ; x: $x; y: $y'</do> <!-- shell command -->
    </step>
    
    <!-- Analyse -->
    <analyser name='analyse'>
      <analyse step='write_numbers'>
        <file use='pattern_all'>stdout</file> <!-- file stdout will be scanned with pattern_all -->
      </analyse>
      <analyse step='write_groupby'>
        <file use='pattern_all'>stdout</file> <!-- file stdout will be scanned with pattern_all -->
      </analyse>
    </analyser>
    
    <!-- Create result figure -->
    <result>
      <use>analyse</use> <!-- use existing analyser -->
      <figure name='fig' title='Title' nrows='2' ncols='3'>
        <plot legend='True'>
          <data x='x2_pat' y='y2_pat' label='LINE' color='green' marker='^' linestyle='dashed'/>
        </plot>
        <plot>
          <data x='x2_pat' y='y2_pat' type='stem'/>
        </plot>
        <plot>
          <data x='x2_pat' y='y2_pat' type='scatter'/>
        </plot>
        <plot>
          <data x='x2_pat' y='y2_pat' type='step' />
        </plot>
        <plot>
          <data x='x2_pat' y='y2_pat' type='bar' />
        </plot>
      </figure>
      <figure name='groupby_fig' savefig='group_fig.png' showfig='False'>
        <plot xlabel='x' ylabel='y' legend='True'>
          <data x='x_pat' y='y_pat' groupby='type_pat'/>
        </plot>
      </figure>
    </result>
  </benchmark>
</jube>
